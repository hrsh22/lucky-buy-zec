# --- quick start: in-memory wallet, "Simulate payment" button, no testnet needed
MOCK_WALLET=1
MOCK_BITREFILL=1

# --- Zcash (testnet, NU7). Real wallet = patched zingo-cli, see README
ZCASH_NETWORK=testnet
LIGHTWALLETD_URL=https://testnet.zec.rocks:443
ZINGO_BIN=/path/to/zingo-cli
TILL_DIR=./wallets/testnet/till
RESERVE_DIR=./wallets/testnet/reserve
BUYER_DIR=./wallets/testnet/buyer
TESTNET_USD_CENTS_PER_ZEC=100000
MIN_CONFIRMATIONS=1

# --- Bitrefill REST v2 (personal API key from bitrefill.com/account/developers)
# one or more keys, comma separated; each is used only up to BITREFILL_DAILY_INVOICE_LIMIT invoices / 24 h
BITREFILL_API_KEYS=
BITREFILL_DAILY_INVOICE_LIMIT=12
BITREFILL_TEST_PRODUCTS=1

# --- server
PORT=8787
QUOTES_PER_IP_PER_10MIN=10

# --- MCP agent: its own capped wallet (lucky_buy). AGENT_ZINGO_BIN = a Nym build for mixnet broadcast
LUCKY_API_URL=http://localhost:8787
AGENT_DIR=./wallets/testnet/buyer
AGENT_ZINGO_BIN=
AGENT_MAX_ZEC_PER_PURCHASE=0.03
AGENT_MAX_ZEC_PER_DAY=0.1
BITREFILL_REAL_BUDGET_USD_CENTS_PER_DAY=1500

# house-run demo wallet that pays real testnet TAZ for visitors without a wallet (its own wallet dir)
DEMO_WALLET=0
DEMO_DIR=./wallets/testnet/demo
